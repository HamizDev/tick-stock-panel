# Host-side image/port controls for the Orvia-safe deployment profile.
TSP_IMAGE=ghcr.io/hua329/tick-stock-panel:latest
TSP_HOST_PORT=3018

# TSP runtime configuration.
TICKFLOW_API_KEY=
AI_PROVIDER=openai_compat
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_DAILY_TOKEN_BUDGET=500000
LOG_LEVEL=INFO

# Set a strong password before first start.
AUTH_PASSWORD=''

# Container-internal values. Do not point DATA_DIR at Orvia paths.
HOST=0.0.0.0
PORT=3018
DATA_DIR=/app/data
